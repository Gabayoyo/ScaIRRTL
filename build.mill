//| mill-version: 1.1.8-native
//| mvnDeps:
//|   - com.goyeau::mill-scalafix_mill1:0.6.0

package build

import com.goyeau.mill.scalafix.ScalafixModule

import mill.*, scalalib.*
import mill.api.BuildCtx

object versions:
    val scair = "0.0.0-1-a7b7f7-SNAPSHOT"
    val scala = "3.9.0"
    val scopt = "4.1.0"
    val chisel = "7.16.0+8-d3babc01-SNAPSHOT"

trait ScaIRRTLModule extends ScalaModule with ScalafixModule:
    override def scalaVersion = versions.scala

    // ScaIR is published to Sonatype snapshots, which is not a default repository.
    override def repositoriesTask = Task.Anon {
        super.repositoriesTask() ++ Seq(
            coursier.MavenRepository(
                "https://central.sonatype.com/repository/maven-snapshots"
            )
        )
    }

object `package` extends ScaIRRTLModule:

    object dialects extends ScaIRRTLModule:
        override def mvnDeps = Seq(
            mvn"io.github.edin-dal::scair-core::${versions.scair}",
            mvn"io.github.edin-dal::scair-dialects-arith::${versions.scair}",
            mvn"io.github.edin-dal::scair-dialects-func::${versions.scair}",
            mvn"io.github.edin-dal::scair-dialects-scf::${versions.scair}"
        )

    object opt extends ScaIRRTLModule with UnidocModule:
        override def docResources = Task.Sources(BuildCtx.workspaceRoot / "docs")

        // Mill's default Unidoc classpath omits this module's own library dependencies.
        override def unidocCompileClasspath = Task:
            (super.unidocCompileClasspath() ++ compileClasspath()).distinct

        override def unidocDocumentTitle = "ScaIRRTL"

        override def unidocSourceUrl = Some(
            "https://github.com/Gabayoyo/ScaIRRTL/blob/main"
        )

        override def unidocOptions = Task:
            Seq("-project", unidocDocumentTitle(), "-siteroot", docResources().head.path.toString)

        def unidocUrl() = Task.Command:
            val index = unidocSite().path / "index.html"
            println(index.toNIO.toUri.toASCIIString)

        override def mvnDeps = Seq(
            mvn"com.github.scopt::scopt::${versions.scopt}",
            mvn"io.github.edin-dal::scair-passes::${versions.scair}"
        )
        override def moduleDeps = Seq(dialects)

    object frontend extends ScaIRRTLModule:
        override def moduleDeps = Seq(dialects)

        override def mvnDeps = Seq(
            mvn"org.chipsalliance::chisel:${versions.chisel}"
        )

        override def scalacPluginMvnDeps = Seq(
            mvn"org.chipsalliance:::chisel-plugin:${versions.chisel}"
        )

        object test extends ScalaTests with TestModule.ScalaTest:
            override def scalaVersion = versions.scala

            override def repositoriesTask = Task.Anon {
                super.repositoriesTask() ++ Seq(
                    coursier.MavenRepository(
                        "https://central.sonatype.com/repository/maven-snapshots"
                    )
                )
            }

            override def mvnDeps = Seq(
                mvn"org.scalatest::scalatest:3.2.20"
            )

            override def scalacPluginMvnDeps = Seq(
                mvn"org.chipsalliance:::chisel-plugin:${versions.chisel}"
            )

    object filechecks extends Module:
        def run() = Task.Command(exclusive = true):
            val launcher = opt.launcher().path
            os.proc("lit", "tests/filecheck", "-v")
                .call(
                    propagateEnv = true,
                    stdout = os.Inherit,
                    stderr = os.Inherit,
                    env = Map("SCAIRRTL_OPT" -> launcher.toString)
                )

    // Top level commands and helpers

    def allChildren =
        allChidrenRec(moduleDirectChildren)

    def allChidrenRec(children: Seq[Module]): Seq[Module] =
        children ++ children.flatMap(child =>
        allChidrenRec(child.moduleDirectChildren)
        )
    // Run all formatting on all sources in the framework
    def format() = Task.Command:
        Task.sequence:
            allChildren.collect:
                case m: ScaIRRTLModule => m.fix()
        scalafmt.ScalafmtModule.reformatAll()()

    // Run all formatting *checks* on all sources in the framework
    def checkFormat() = Task.Command:
        Task.sequence:
            allChildren.collect:
                case m: ScaIRRTLModule => m.fix("--check")
        scalafmt.ScalafmtModule.checkFormatAll()()
