// RUN: choco-opt -p convert-choco-to-mlir %s | filecheck %s
// RUN: choco-opt -p convert-choco-to-arith %s | filecheck %s --check-prefix=ARITH
// RUN: choco-opt -p convert-choco-to-scf %s | filecheck %s --check-prefix=CONTROL
// RUN: choco-opt -p convert-choco-to-mlir,reconcile-unrealized-casts %s | filecheck %s --check-prefix=COMPOSE
// RUN: choco-opt -p convert-choco-to-mlir %s > %t.convert-choco-to-mlir
// RUN: choco-opt -p convert-choco-to-func,convert-choco-to-scf,convert-choco-to-arith,reconcile-unrealized-casts %s > %t.explicit
// RUN: diff %t.convert-choco-to-mlir %t.explicit

val integer = -((8 / 2) + 3 * 4 - 1)
val floating = -(1.5 + 2.0) / 3.0
val compared = integer >= 0
val logic = !false && (true || false)
val selected = if compared then integer else 0

// CHECK:       builtin.module {
// CHECK-NEXT:    %0 = "arith.constant"() <{value = 8 : i32}> : () -> i32
// CHECK-NEXT:    %1 = "arith.constant"() <{value = 2 : i32}> : () -> i32
// CHECK-NEXT:    %2 = "arith.divsi"(%0, %1) : (i32, i32) -> i32
// CHECK-NEXT:    %3 = "arith.constant"() <{value = 3 : i32}> : () -> i32
// CHECK-NEXT:    %4 = "arith.constant"() <{value = 4 : i32}> : () -> i32
// CHECK-NEXT:    %5 = "arith.muli"(%3, %4) <{overflowFlags = #arith.overflow<none>}> : (i32, i32) -> i32
// CHECK-NEXT:    %6 = "arith.addi"(%2, %5) <{overflowFlags = #arith.overflow<none>}> : (i32, i32) -> i32
// CHECK-NEXT:    %7 = "arith.constant"() <{value = 1 : i32}> : () -> i32
// CHECK-NEXT:    %8 = "arith.subi"(%6, %7) <{overflowFlags = #arith.overflow<none>}> : (i32, i32) -> i32
// CHECK-NEXT:    %9 = "arith.constant"() <{value = 0 : i32}> : () -> i32
// CHECK-NEXT:    %10 = "arith.subi"(%9, %8) <{overflowFlags = #arith.overflow<none>}> : (i32, i32) -> i32
// CHECK-NEXT:    %11 = "arith.constant"() <{value = 1.5 : f64}> : () -> f64
// CHECK-NEXT:    %12 = "arith.constant"() <{value = 2.0 : f64}> : () -> f64
// CHECK-NEXT:    %13 = "arith.addf"(%11, %12) <{fastmath = #arith.fastmath<none>}> : (f64, f64) -> f64
// CHECK-NEXT:    %14 = "arith.negf"(%13) <{fastmath = #arith.fastmath<none>}> : (f64) -> f64
// CHECK-NEXT:    %15 = "arith.constant"() <{value = 3.0 : f64}> : () -> f64
// CHECK-NEXT:    %16 = "arith.divf"(%14, %15) <{fastmath = #arith.fastmath<none>}> : (f64, f64) -> f64
// CHECK-NEXT:    %17 = "arith.constant"() <{value = 0 : i32}> : () -> i32
// CHECK-NEXT:    %18 = "arith.cmpi"(%10, %17) <{predicate = 5 : i64}> : (i32, i32) -> i1
// CHECK-NEXT:    %19 = "arith.constant"() <{value = false}> : () -> i1
// CHECK-NEXT:    %20 = "arith.constant"() <{value = true}> : () -> i1
// CHECK-NEXT:    %21 = "arith.xori"(%19, %20) : (i1, i1) -> i1
// CHECK-NEXT:    %22 = "arith.constant"() <{value = true}> : () -> i1
// CHECK-NEXT:    %23 = "arith.constant"() <{value = false}> : () -> i1
// CHECK-NEXT:    %24 = "arith.ori"(%22, %23) : (i1, i1) -> i1
// CHECK-NEXT:    %25 = "arith.andi"(%21, %24) : (i1, i1) -> i1
// CHECK-NEXT:    %26 = "scf.if"(%18) ({
// CHECK-NEXT:      scf.yield %10 : i32
// CHECK-NEXT:    }, {
// CHECK-NEXT:      %27 = "arith.constant"() <{value = 0 : i32}> : () -> i32
// CHECK-NEXT:      scf.yield %27 : i32
// CHECK-NEXT:    }) : (i1) -> i32
// CHECK-NEXT:    func.func @main() -> i32 {
// CHECK-NEXT:      %27 = "arith.constant"() <{value = 0 : i32}> : () -> i32
// CHECK-NEXT:      func.return %27 : i32
// CHECK-NEXT:    }
// CHECK-NEXT:  }

// ARITH:       builtin.module {
// ARITH-NEXT:    %0 = "arith.constant"() <{value = 8 : i32}> : () -> i32
// ARITH-NEXT:    %1 = "arith.constant"() <{value = 2 : i32}> : () -> i32
// ARITH-NEXT:    %2 = "arith.divsi"(%0, %1) : (i32, i32) -> i32
// ARITH-NEXT:    %3 = "arith.constant"() <{value = 3 : i32}> : () -> i32
// ARITH-NEXT:    %4 = "arith.constant"() <{value = 4 : i32}> : () -> i32
// ARITH-NEXT:    %5 = "arith.muli"(%3, %4) <{overflowFlags = #arith.overflow<none>}> : (i32, i32) -> i32
// ARITH-NEXT:    %6 = "arith.addi"(%2, %5) <{overflowFlags = #arith.overflow<none>}> : (i32, i32) -> i32
// ARITH-NEXT:    %7 = "arith.constant"() <{value = 1 : i32}> : () -> i32
// ARITH-NEXT:    %8 = "arith.subi"(%6, %7) <{overflowFlags = #arith.overflow<none>}> : (i32, i32) -> i32
// ARITH-NEXT:    %9 = "arith.constant"() <{value = 0 : i32}> : () -> i32
// ARITH-NEXT:    %10 = "arith.subi"(%9, %8) <{overflowFlags = #arith.overflow<none>}> : (i32, i32) -> i32
// ARITH-NEXT:    %11 = "builtin.unrealized_conversion_cast"(%10) : (i32) -> !chocola.int
// ARITH-NEXT:    %12 = "arith.constant"() <{value = 1.5 : f64}> : () -> f64
// ARITH-NEXT:    %13 = "arith.constant"() <{value = 2.0 : f64}> : () -> f64
// ARITH-NEXT:    %14 = "arith.addf"(%12, %13) <{fastmath = #arith.fastmath<none>}> : (f64, f64) -> f64
// ARITH-NEXT:    %15 = "arith.negf"(%14) <{fastmath = #arith.fastmath<none>}> : (f64) -> f64
// ARITH-NEXT:    %16 = "arith.constant"() <{value = 3.0 : f64}> : () -> f64
// ARITH-NEXT:    %17 = "arith.divf"(%15, %16) <{fastmath = #arith.fastmath<none>}> : (f64, f64) -> f64
// ARITH-NEXT:    %18 = "arith.constant"() <{value = 0 : i32}> : () -> i32
// ARITH-NEXT:    %19 = "arith.cmpi"(%10, %18) <{predicate = 5 : i64}> : (i32, i32) -> i1
// ARITH-NEXT:    %20 = "builtin.unrealized_conversion_cast"(%19) : (i1) -> !chocola.bool
// ARITH-NEXT:    %21 = "arith.constant"() <{value = false}> : () -> i1
// ARITH-NEXT:    %22 = "arith.constant"() <{value = true}> : () -> i1
// ARITH-NEXT:    %23 = "arith.xori"(%21, %22) : (i1, i1) -> i1
// ARITH-NEXT:    %24 = "arith.constant"() <{value = true}> : () -> i1
// ARITH-NEXT:    %25 = "arith.constant"() <{value = false}> : () -> i1
// ARITH-NEXT:    %26 = "arith.ori"(%24, %25) : (i1, i1) -> i1
// ARITH-NEXT:    %27 = "arith.andi"(%23, %26) : (i1, i1) -> i1
// ARITH-NEXT:    %28 = "chocola.if"(%20) ({
// ARITH-NEXT:      "chocola.yield"(%11) : (!chocola.int) -> ()
// ARITH-NEXT:    }, {
// ARITH-NEXT:      %29 = "arith.constant"() <{value = 0 : i32}> : () -> i32
// ARITH-NEXT:      %30 = "builtin.unrealized_conversion_cast"(%29) : (i32) -> !chocola.int
// ARITH-NEXT:      "chocola.yield"(%30) : (!chocola.int) -> ()
// ARITH-NEXT:    }) : (!chocola.bool) -> !chocola.int
// ARITH-NEXT:    "chocola.func"() <{sym = @main, typeParams = [], functionType = () -> !chocola.int}> ({
// ARITH-NEXT:      %29 = "arith.constant"() <{value = 0 : i32}> : () -> i32
// ARITH-NEXT:      %30 = "builtin.unrealized_conversion_cast"(%29) : (i32) -> !chocola.int
// ARITH-NEXT:      "chocola.return"(%30) : (!chocola.int) -> ()
// ARITH-NEXT:    }) : () -> ()
// ARITH-NEXT:  }

// CONTROL:       builtin.module {
// CONTROL-NEXT:    %0 = "chocola.constant"() <{value = "8"}> : () -> !chocola.int
// CONTROL-NEXT:    %1 = "chocola.constant"() <{value = "2"}> : () -> !chocola.int
// CONTROL-NEXT:    %2 = "chocola.div"(%0, %1) : (!chocola.int, !chocola.int) -> !chocola.int
// CONTROL-NEXT:    %3 = "chocola.constant"() <{value = "3"}> : () -> !chocola.int
// CONTROL-NEXT:    %4 = "chocola.constant"() <{value = "4"}> : () -> !chocola.int
// CONTROL-NEXT:    %5 = "chocola.mul"(%3, %4) : (!chocola.int, !chocola.int) -> !chocola.int
// CONTROL-NEXT:    %6 = "chocola.add"(%2, %5) : (!chocola.int, !chocola.int) -> !chocola.int
// CONTROL-NEXT:    %7 = "chocola.constant"() <{value = "1"}> : () -> !chocola.int
// CONTROL-NEXT:    %8 = "chocola.sub"(%6, %7) : (!chocola.int, !chocola.int) -> !chocola.int
// CONTROL-NEXT:    %9 = "chocola.neg"(%8) : (!chocola.int) -> !chocola.int
// CONTROL-NEXT:    %10 = "builtin.unrealized_conversion_cast"(%9) : (!chocola.int) -> i32
// CONTROL-NEXT:    %11 = "chocola.constant"() <{value = "1.5"}> : () -> !chocola.double
// CONTROL-NEXT:    %12 = "chocola.constant"() <{value = "2.0"}> : () -> !chocola.double
// CONTROL-NEXT:    %13 = "chocola.add"(%11, %12) : (!chocola.double, !chocola.double) -> !chocola.double
// CONTROL-NEXT:    %14 = "chocola.neg"(%13) : (!chocola.double) -> !chocola.double
// CONTROL-NEXT:    %15 = "chocola.constant"() <{value = "3.0"}> : () -> !chocola.double
// CONTROL-NEXT:    %16 = "chocola.div"(%14, %15) : (!chocola.double, !chocola.double) -> !chocola.double
// CONTROL-NEXT:    %17 = "chocola.constant"() <{value = "0"}> : () -> !chocola.int
// CONTROL-NEXT:    %18 = "chocola.geq"(%9, %17) : (!chocola.int, !chocola.int) -> !chocola.bool
// CONTROL-NEXT:    %19 = "builtin.unrealized_conversion_cast"(%18) : (!chocola.bool) -> i1
// CONTROL-NEXT:    %20 = "chocola.constant"() <{value = "false"}> : () -> !chocola.bool
// CONTROL-NEXT:    %21 = "chocola.not"(%20) : (!chocola.bool) -> !chocola.bool
// CONTROL-NEXT:    %22 = "chocola.constant"() <{value = "true"}> : () -> !chocola.bool
// CONTROL-NEXT:    %23 = "chocola.constant"() <{value = "false"}> : () -> !chocola.bool
// CONTROL-NEXT:    %24 = "chocola.or"(%22, %23) : (!chocola.bool, !chocola.bool) -> !chocola.bool
// CONTROL-NEXT:    %25 = "chocola.and"(%21, %24) : (!chocola.bool, !chocola.bool) -> !chocola.bool
// CONTROL-NEXT:    %26 = "scf.if"(%19) ({
// CONTROL-NEXT:      scf.yield %10 : i32
// CONTROL-NEXT:    }, {
// CONTROL-NEXT:      %27 = "chocola.constant"() <{value = "0"}> : () -> !chocola.int
// CONTROL-NEXT:      %28 = "builtin.unrealized_conversion_cast"(%27) : (!chocola.int) -> i32
// CONTROL-NEXT:      scf.yield %28 : i32
// CONTROL-NEXT:    }) : (i1) -> i32
// CONTROL-NEXT:    "chocola.func"() <{sym = @main, typeParams = [], functionType = () -> !chocola.int}> ({
// CONTROL-NEXT:      %27 = "chocola.constant"() <{value = "0"}> : () -> !chocola.int
// CONTROL-NEXT:      "chocola.return"(%27) : (!chocola.int) -> ()
// CONTROL-NEXT:    }) : () -> ()
// CONTROL-NEXT:  }

// COMPOSE:       builtin.module {
// COMPOSE-NEXT:    %0 = "arith.constant"() <{value = 8 : i32}> : () -> i32
// COMPOSE-NEXT:    %1 = "arith.constant"() <{value = 2 : i32}> : () -> i32
// COMPOSE-NEXT:    %2 = "arith.divsi"(%0, %1) : (i32, i32) -> i32
// COMPOSE-NEXT:    %3 = "arith.constant"() <{value = 3 : i32}> : () -> i32
// COMPOSE-NEXT:    %4 = "arith.constant"() <{value = 4 : i32}> : () -> i32
// COMPOSE-NEXT:    %5 = "arith.muli"(%3, %4) <{overflowFlags = #arith.overflow<none>}> : (i32, i32) -> i32
// COMPOSE-NEXT:    %6 = "arith.addi"(%2, %5) <{overflowFlags = #arith.overflow<none>}> : (i32, i32) -> i32
// COMPOSE-NEXT:    %7 = "arith.constant"() <{value = 1 : i32}> : () -> i32
// COMPOSE-NEXT:    %8 = "arith.subi"(%6, %7) <{overflowFlags = #arith.overflow<none>}> : (i32, i32) -> i32
// COMPOSE-NEXT:    %9 = "arith.constant"() <{value = 0 : i32}> : () -> i32
// COMPOSE-NEXT:    %10 = "arith.subi"(%9, %8) <{overflowFlags = #arith.overflow<none>}> : (i32, i32) -> i32
// COMPOSE-NEXT:    %11 = "arith.constant"() <{value = 1.5 : f64}> : () -> f64
// COMPOSE-NEXT:    %12 = "arith.constant"() <{value = 2.0 : f64}> : () -> f64
// COMPOSE-NEXT:    %13 = "arith.addf"(%11, %12) <{fastmath = #arith.fastmath<none>}> : (f64, f64) -> f64
// COMPOSE-NEXT:    %14 = "arith.negf"(%13) <{fastmath = #arith.fastmath<none>}> : (f64) -> f64
// COMPOSE-NEXT:    %15 = "arith.constant"() <{value = 3.0 : f64}> : () -> f64
// COMPOSE-NEXT:    %16 = "arith.divf"(%14, %15) <{fastmath = #arith.fastmath<none>}> : (f64, f64) -> f64
// COMPOSE-NEXT:    %17 = "arith.constant"() <{value = 0 : i32}> : () -> i32
// COMPOSE-NEXT:    %18 = "arith.cmpi"(%10, %17) <{predicate = 5 : i64}> : (i32, i32) -> i1
// COMPOSE-NEXT:    %19 = "arith.constant"() <{value = false}> : () -> i1
// COMPOSE-NEXT:    %20 = "arith.constant"() <{value = true}> : () -> i1
// COMPOSE-NEXT:    %21 = "arith.xori"(%19, %20) : (i1, i1) -> i1
// COMPOSE-NEXT:    %22 = "arith.constant"() <{value = true}> : () -> i1
// COMPOSE-NEXT:    %23 = "arith.constant"() <{value = false}> : () -> i1
// COMPOSE-NEXT:    %24 = "arith.ori"(%22, %23) : (i1, i1) -> i1
// COMPOSE-NEXT:    %25 = "arith.andi"(%21, %24) : (i1, i1) -> i1
// COMPOSE-NEXT:    %26 = "scf.if"(%18) ({
// COMPOSE-NEXT:      scf.yield %10 : i32
// COMPOSE-NEXT:    }, {
// COMPOSE-NEXT:      %27 = "arith.constant"() <{value = 0 : i32}> : () -> i32
// COMPOSE-NEXT:      scf.yield %27 : i32
// COMPOSE-NEXT:    }) : (i1) -> i32
// COMPOSE-NEXT:    func.func @main() -> i32 {
// COMPOSE-NEXT:      %27 = "arith.constant"() <{value = 0 : i32}> : () -> i32
// COMPOSE-NEXT:      func.return %27 : i32
// COMPOSE-NEXT:    }
// COMPOSE-NEXT:  }
