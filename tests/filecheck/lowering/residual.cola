// RUN: choco-opt -p convert-choco-to-mlir %s | filecheck %s

def identity[a](x: a): a = x
val generic = identity(1)
val text = "hello"
val pair = (1, true)
val list = 1 :: Nil
val lambda = (x: Int) => x + 1
val captured = 3
def addsCaptured(x: Int): Int = x + captured

// CHECK:       builtin.module {
// CHECK-NEXT:    "chocola.func"() <{sym = @identity, typeParams = [@a], functionType = (!chocola.named<@a, []>) -> !chocola.named<@a, []>}> ({
// CHECK-NEXT:    ^bb0(%0: !chocola.named<@a, []>):
// CHECK-NEXT:      "chocola.return"(%0) : (!chocola.named<@a, []>) -> ()
// CHECK-NEXT:    }) : () -> ()
// CHECK-NEXT:    %0 = "arith.constant"() <{value = 1 : i32}> : () -> i32
// CHECK-NEXT:    %1 = "builtin.unrealized_conversion_cast"(%0) : (i32) -> !chocola.int
// CHECK-NEXT:    %2 = "chocola.direct_call"(%1) <{callee = @identity}> : (!chocola.int) -> !chocola.int
// CHECK-NEXT:    %3 = "chocola.constant"() <{value = "hello"}> : () -> !chocola.string
// CHECK-NEXT:    %4 = "arith.constant"() <{value = 1 : i32}> : () -> i32
// CHECK-NEXT:    %5 = "builtin.unrealized_conversion_cast"(%4) : (i32) -> !chocola.int
// CHECK-NEXT:    %6 = "arith.constant"() <{value = true}> : () -> i1
// CHECK-NEXT:    %7 = "builtin.unrealized_conversion_cast"(%6) : (i1) -> !chocola.bool
// CHECK-NEXT:    %8 = "chocola.tuple"(%5, %7) : (!chocola.int, !chocola.bool) -> !chocola.tuple<!chocola.int, !chocola.bool>
// CHECK-NEXT:    %9 = "arith.constant"() <{value = 1 : i32}> : () -> i32
// CHECK-NEXT:    %10 = "builtin.unrealized_conversion_cast"(%9) : (i32) -> !chocola.int
// CHECK-NEXT:    %11 = "chocola.constant"() <{value = "Nil"}> : () -> !chocola.list<!chocola.int>
// CHECK-NEXT:    %12 = "chocola.cons"(%10, %11) : (!chocola.int, !chocola.list<!chocola.int>) -> !chocola.list<!chocola.int>
// CHECK-NEXT:    %13 = "chocola.lambda"() ({
// CHECK-NEXT:    ^bb0(%14: !chocola.int):
// CHECK-NEXT:      %15 = "builtin.unrealized_conversion_cast"(%14) : (!chocola.int) -> i32
// CHECK-NEXT:      %16 = "arith.constant"() <{value = 1 : i32}> : () -> i32
// CHECK-NEXT:      %17 = "arith.addi"(%15, %16) <{overflowFlags = #arith.overflow<none>}> : (i32, i32) -> i32
// CHECK-NEXT:      %18 = "builtin.unrealized_conversion_cast"(%17) : (i32) -> !chocola.int
// CHECK-NEXT:      "chocola.yield"(%18) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : () -> !chocola.fun<[!chocola.int], !chocola.int>
// CHECK-NEXT:    %14 = "arith.constant"() <{value = 3 : i32}> : () -> i32
// CHECK-NEXT:    "chocola.func"() <{sym = @addsCaptured, typeParams = [], functionType = (!chocola.int) -> !chocola.int}> ({
// CHECK-NEXT:    ^bb0(%15: !chocola.int):
// CHECK-NEXT:      %16 = "builtin.unrealized_conversion_cast"(%15) : (!chocola.int) -> i32
// CHECK-NEXT:      %17 = "arith.addi"(%16, %14) <{overflowFlags = #arith.overflow<none>}> : (i32, i32) -> i32
// CHECK-NEXT:      %18 = "builtin.unrealized_conversion_cast"(%17) : (i32) -> !chocola.int
// CHECK-NEXT:      "chocola.return"(%18) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : () -> ()
// CHECK-NEXT:    func.func @main() -> i32 {
// CHECK-NEXT:      %15 = "arith.constant"() <{value = 0 : i32}> : () -> i32
// CHECK-NEXT:      func.return %15 : i32
// CHECK-NEXT:    }
// CHECK-NEXT:  }
