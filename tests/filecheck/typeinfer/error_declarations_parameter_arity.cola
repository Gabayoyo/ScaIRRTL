// RUN: choco-opt --parsing-diagnostics --dump-ast %s | filecheck %s

def bad[a](x: a[Int]): a = x

// CHECK:       Parsing succeeded.
// CHECK-NEXT:  {{.*}}/error_declarations_parameter_arity.cola:3:1-29: Type error: Type a expects 0 type arguments, got 1
// CHECK-NEXT:  Program(List(DefDecl(bad,List(a),List((x,TName(a,List(TInt)))),TName(a,List()),Var(x,Some(TError)))),None)
