// RUN: choco-opt --parsing-diagnostics --dump-ast %s | filecheck %s

enum Box[a]:
  case MkBox(value: a)
def choose(x: Box[Int], y: Box[Bool]): Box[Int] = if true then x else y

// CHECK:       Parsing succeeded.
// CHECK-NEXT:  {{.*}}/error_enum_arguments_branch_types.cola:5:71-72: Type error: Type mismatch: expected TInt but got TBool
// CHECK-NEXT:  Program(List(EnumDecl(Box,List(a),List(EnumCase(MkBox,List((value,TName(a,List())))))), DefDecl(choose,List(),List((x,TName(Box,List(TInt))), (y,TName(Box,List(TBool)))),TName(Box,List(TInt)),If(Lit(BoolLit(true),Some(TBool)),Var(x,Some(TName(Box,List(TInt)))),Var(y,Some(TName(Box,List(TBool)))),Some(TName(Box,List(TInt)))))),None)
