// RUN: choco-opt %s | filecheck %s
// IR-level: if-op condition is !chocola.bool; result is the branch type.

val x = if true then 42 else 0

// CHECK: "chocola.if"({{.*}}) ({
// CHECK:   {{.*}} = "chocola.constant"() <{value = "42"}> : () -> !chocola.int
// CHECK:   "chocola.yield"({{.*}}) : (!chocola.int) -> ()
// CHECK: }, {
// CHECK:   {{.*}} = "chocola.constant"() <{value = "0"}> : () -> !chocola.int
// CHECK:   "chocola.yield"({{.*}}) : (!chocola.int) -> ()
// CHECK: }) : (!chocola.bool) -> !chocola.int
