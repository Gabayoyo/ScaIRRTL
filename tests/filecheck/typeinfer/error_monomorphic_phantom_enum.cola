// RUN: choco-opt --parsing-diagnostics --dump-ast %s | filecheck %s

enum Phantom[a]:
  case Empty()
val empty = Empty()

// CHECK:       Parsing succeeded.
// CHECK-NEXT:  {{.*}}/error_monomorphic_phantom_enum.cola:5:13-20: Type error: Ambiguous inferred type: TMeta(1)
// CHECK-NEXT:  Program(List(EnumDecl(Phantom,List(a),List(EnumCase(Empty,List()))), ValDecl(empty,Construct(Empty,List(),Some(TName(Phantom,List(TMeta(1))))),None)),None)
