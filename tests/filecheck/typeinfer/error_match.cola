// RUN: choco-opt --parsing-diagnostics --dump-ast %s 2>&1 | filecheck %s
// Match checks reject constructors that belong to a different enum than the
// scrutinee, and require full coverage of the scrutinee's declared
// constructors (exhaustiveness, T-Match's {C1,...} = constructors(T)).

enum Shape:
  case Circle(r: Int)
  case Rect(w: Int, h: Int)

enum Color:
  case Red()

val bad1 = Circle(1) match
  case Circle(r) => r

val bad2 = Circle(1) match
  case Circle(r) => r
  case Red() => 0

// CHECK: Parsing succeeded.
// CHECK: {{.*}}error_match.cola:13:12-14.22: Type error: Non-exhaustive match on Shape: missing Rect
// CHECK: {{.*}}error_match.cola:18:3-18: Type error: Constructor Red does not belong to enum Shape
// CHECK: {{.*}}error_match.cola:16:12-18.18: Type error: Non-exhaustive match on Shape: missing Rect
