// RUN: choco-opt --parsing-diagnostics --dump-ast %s | filecheck %s

def zero(): Int = 0
val bad = zero(1)

// CHECK:       Parsing succeeded.
// CHECK-NEXT:  {{.*}}/error_function_lists_zero_arity.cola:4:11-18: Type error: Function expects 0 args, got 1
// CHECK-NEXT:  Program(List(DefDecl(zero,List(),List(),TInt,Lit(IntLit(0),Some(TInt))), ValDecl(bad,Apply(Var(zero,Some(TFun(List(),TInt))),List(Lit(IntLit(1),Some(TInt))),Some(TInt)),None)),None)
