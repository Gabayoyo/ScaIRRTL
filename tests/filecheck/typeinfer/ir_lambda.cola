// RUN: choco-opt %s | filecheck %s
// IR-level: lambda block args carry the parameter types from the AST.

val f = (x: Int) => x + 1

// The lambda body block arg has type !chocola.int.
// The lambda result has type !chocola.fun<[!chocola.int], !chocola.int>.
// CHECK:       builtin.module {
// CHECK-NEXT:    %0 = "chocola.lambda"() ({
// CHECK-NEXT:    ^bb0(%1: !chocola.int):
// CHECK-NEXT:      %2 = "chocola.constant"() <{value = "1"}> : () -> !chocola.int
// CHECK-NEXT:      %3 = "chocola.add"(%1, %2) : (!chocola.int, !chocola.int) -> !chocola.int
// CHECK-NEXT:      "chocola.yield"(%3) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : () -> !chocola.fun<[!chocola.int], !chocola.int>
// CHECK-NEXT:    "chocola.func"() <{sym = @main, typeParams = [], functionType = () -> !chocola.int}> ({
// CHECK-NEXT:      %1 = "chocola.constant"() <{value = "0"}> : () -> !chocola.int
// CHECK-NEXT:      "chocola.return"(%1) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : () -> ()
// CHECK-NEXT:  }
