// RUN: choco-opt --dump-ast %s | filecheck %s
// A generic def is instantiated independently at each call site (Scheme +
// instantiate), and a recursive def type-checks against its own declared
// signature by binding its own name in its body's environment up front.

def identity[a](x: a): a = x
val i1 = identity(1)
val i2 = identity(true)

def fact(n: Int): Int = if n <= 1 then 1 else n * fact(n - 1)

// CHECK: Parsing succeeded.
// CHECK: DefDecl(identity,List(a),List((x,TName(a,List()))),TName(a,List()),Var(x,Some(TParam(a,1))))
// CHECK: ValDecl(i1,Apply(Var(identity,Some(TFun(List(TInt),TInt))),List(Lit(IntLit(1),Some(TInt))),Some(TInt)),None)
// CHECK: ValDecl(i2,Apply(Var(identity,Some(TFun(List(TBool),TBool))),List(Lit(BoolLit(true),Some(TBool))),Some(TBool)),None)
// CHECK: DefDecl(fact,List(),List((n,TInt)),TInt,If(BinOp(<=,Var(n,Some(TInt)),Lit(IntLit(1),Some(TInt)),Some(TBool)),Lit(IntLit(1),Some(TInt)),BinOp(*,Var(n,Some(TInt)),Apply(Var(fact,Some(TFun(List(TInt),TInt))),List(BinOp(-,Var(n,Some(TInt)),Lit(IntLit(1),Some(TInt)),Some(TInt))),Some(TInt)),Some(TInt)),Some(TInt)))
