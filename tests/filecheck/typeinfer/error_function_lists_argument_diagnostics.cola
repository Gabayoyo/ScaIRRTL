// RUN: choco-opt --parsing-diagnostics --dump-ast %s | filecheck %s

def add(x: Int, y: Int): Int = x + y
val bad = add(missing)

// CHECK:       Parsing succeeded.
// CHECK-NEXT:  {{.*}}/error_function_lists_argument_diagnostics.cola:4:15-22: Type error: Unbound variable: missing
// CHECK-NEXT:  {{.*}}/error_function_lists_argument_diagnostics.cola:4:11-23: Type error: Function expects 2 args, got 1
// CHECK-NEXT:  Program(List(DefDecl(add,List(),List((x,TInt), (y,TInt)),TInt,BinOp(+,Var(x,Some(TInt)),Var(y,Some(TInt)),Some(TInt))), ValDecl(bad,Apply(Var(add,Some(TFun(List(TInt, TInt),TInt))),List(Var(missing,Some(TInt))),Some(TInt)),None)),None)
