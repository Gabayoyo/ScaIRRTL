// RUN: choco-opt %s | filecheck %s
// IR-level: literal constants carry typed results instead of !chocola.unknown.

val i = 42
val d = 3.14
val s = "hello"
val b = true

// CHECK:       builtin.module {
// CHECK-NEXT:    %0 = "chocola.constant"() <{value = "42"}> : () -> !chocola.int
// CHECK-NEXT:    %1 = "chocola.constant"() <{value = "3.14"}> : () -> !chocola.double
// CHECK-NEXT:    %2 = "chocola.constant"() <{value = "hello"}> : () -> !chocola.string
// CHECK-NEXT:    %3 = "chocola.constant"() <{value = "true"}> : () -> !chocola.bool
// CHECK-NEXT:    "chocola.func"() <{sym = @main, typeParams = [], functionType = () -> !chocola.int}> ({
// CHECK-NEXT:      %4 = "chocola.constant"() <{value = "0"}> : () -> !chocola.int
// CHECK-NEXT:      "chocola.return"(%4) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : () -> ()
// CHECK-NEXT:  }
