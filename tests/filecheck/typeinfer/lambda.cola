// RUN: choco-opt --dump-ast %s | filecheck %s

// Lambda parameter types are explicit; body type is inferred.
// Result type is the TFun with one list of all parameters.
val double = (x: Int) => x * 2
val add    = (x: Int, y: Int) => x + y
val flip   = (b: Bool) => !b

// CHECK: Lambda(List((x,TInt)),BinOp(*,Var(x,Some(TInt)),Lit(IntLit(2),Some(TInt)),Some(TInt)),Some(TFun(List(TInt),TInt)))
// CHECK: Lambda(List((x,TInt), (y,TInt)),BinOp(+,Var(x,Some(TInt)),Var(y,Some(TInt)),Some(TInt)),Some(TFun(List(TInt, TInt),TInt)))
// CHECK: Lambda(List((b,TBool)),UnOp(!,Var(b,Some(TBool)),Some(TBool)),Some(TFun(List(TBool),TBool)))
