// RUN: choco-opt %s | choco-opt | filecheck %s

val forwarded = later(1)
val captured = 4
def first(n: Int): Int = if n == 0 then captured else second(n - 1)
def second(n: Int): Int = if n == 0 then first(0) else first(n - 1)
def later(n: Int): Int = n + 1
def recur(n: Int): Int = if n == 0 then 0 else recur(n - 1)
val ordered = 6
val result = first(2)

// CHECK:       builtin.module {
// CHECK-NEXT:    %0 = "chocola.constant"() <{value = "1"}> : () -> !chocola.int
// CHECK-NEXT:    %1 = "chocola.direct_call"(%0) <{callee = @later}> : (!chocola.int) -> !chocola.int
// CHECK-NEXT:    %2 = "chocola.constant"() <{value = "4"}> : () -> !chocola.int
// CHECK-NEXT:    "chocola.func"() <{sym = @first, typeParams = [], functionType = (!chocola.int) -> !chocola.int}> ({
// CHECK-NEXT:    ^bb0(%3: !chocola.int):
// CHECK-NEXT:      %4 = "chocola.constant"() <{value = "0"}> : () -> !chocola.int
// CHECK-NEXT:      %5 = "chocola.eq"(%3, %4) : (!chocola.int, !chocola.int) -> !chocola.bool
// CHECK-NEXT:      %6 = "chocola.if"(%5) ({
// CHECK-NEXT:        "chocola.yield"(%2) : (!chocola.int) -> ()
// CHECK-NEXT:      }, {
// CHECK-NEXT:        %7 = "chocola.constant"() <{value = "1"}> : () -> !chocola.int
// CHECK-NEXT:        %8 = "chocola.sub"(%3, %7) : (!chocola.int, !chocola.int) -> !chocola.int
// CHECK-NEXT:        %9 = "chocola.direct_call"(%8) <{callee = @second}> : (!chocola.int) -> !chocola.int
// CHECK-NEXT:        "chocola.yield"(%9) : (!chocola.int) -> ()
// CHECK-NEXT:      }) : (!chocola.bool) -> !chocola.int
// CHECK-NEXT:      "chocola.return"(%6) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : () -> ()
// CHECK-NEXT:    "chocola.func"() <{sym = @second, typeParams = [], functionType = (!chocola.int) -> !chocola.int}> ({
// CHECK-NEXT:    ^bb0(%3: !chocola.int):
// CHECK-NEXT:      %4 = "chocola.constant"() <{value = "0"}> : () -> !chocola.int
// CHECK-NEXT:      %5 = "chocola.eq"(%3, %4) : (!chocola.int, !chocola.int) -> !chocola.bool
// CHECK-NEXT:      %6 = "chocola.if"(%5) ({
// CHECK-NEXT:        %7 = "chocola.constant"() <{value = "0"}> : () -> !chocola.int
// CHECK-NEXT:        %8 = "chocola.direct_call"(%7) <{callee = @first}> : (!chocola.int) -> !chocola.int
// CHECK-NEXT:        "chocola.yield"(%8) : (!chocola.int) -> ()
// CHECK-NEXT:      }, {
// CHECK-NEXT:        %7 = "chocola.constant"() <{value = "1"}> : () -> !chocola.int
// CHECK-NEXT:        %8 = "chocola.sub"(%3, %7) : (!chocola.int, !chocola.int) -> !chocola.int
// CHECK-NEXT:        %9 = "chocola.direct_call"(%8) <{callee = @first}> : (!chocola.int) -> !chocola.int
// CHECK-NEXT:        "chocola.yield"(%9) : (!chocola.int) -> ()
// CHECK-NEXT:      }) : (!chocola.bool) -> !chocola.int
// CHECK-NEXT:      "chocola.return"(%6) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : () -> ()
// CHECK-NEXT:    "chocola.func"() <{sym = @later, typeParams = [], functionType = (!chocola.int) -> !chocola.int}> ({
// CHECK-NEXT:    ^bb0(%3: !chocola.int):
// CHECK-NEXT:      %4 = "chocola.constant"() <{value = "1"}> : () -> !chocola.int
// CHECK-NEXT:      %5 = "chocola.add"(%3, %4) : (!chocola.int, !chocola.int) -> !chocola.int
// CHECK-NEXT:      "chocola.return"(%5) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : () -> ()
// CHECK-NEXT:    "chocola.func"() <{sym = @recur, typeParams = [], functionType = (!chocola.int) -> !chocola.int}> ({
// CHECK-NEXT:    ^bb0(%3: !chocola.int):
// CHECK-NEXT:      %4 = "chocola.constant"() <{value = "0"}> : () -> !chocola.int
// CHECK-NEXT:      %5 = "chocola.eq"(%3, %4) : (!chocola.int, !chocola.int) -> !chocola.bool
// CHECK-NEXT:      %6 = "chocola.if"(%5) ({
// CHECK-NEXT:        %7 = "chocola.constant"() <{value = "0"}> : () -> !chocola.int
// CHECK-NEXT:        "chocola.yield"(%7) : (!chocola.int) -> ()
// CHECK-NEXT:      }, {
// CHECK-NEXT:        %7 = "chocola.constant"() <{value = "1"}> : () -> !chocola.int
// CHECK-NEXT:        %8 = "chocola.sub"(%3, %7) : (!chocola.int, !chocola.int) -> !chocola.int
// CHECK-NEXT:        %9 = "chocola.direct_call"(%8) <{callee = @recur}> : (!chocola.int) -> !chocola.int
// CHECK-NEXT:        "chocola.yield"(%9) : (!chocola.int) -> ()
// CHECK-NEXT:      }) : (!chocola.bool) -> !chocola.int
// CHECK-NEXT:      "chocola.return"(%6) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : () -> ()
// CHECK-NEXT:    %3 = "chocola.constant"() <{value = "6"}> : () -> !chocola.int
// CHECK-NEXT:    %4 = "chocola.constant"() <{value = "2"}> : () -> !chocola.int
// CHECK-NEXT:    %5 = "chocola.direct_call"(%4) <{callee = @first}> : (!chocola.int) -> !chocola.int
// CHECK-NEXT:    "chocola.func"() <{sym = @main, typeParams = [], functionType = () -> !chocola.int}> ({
// CHECK-NEXT:      %6 = "chocola.constant"() <{value = "0"}> : () -> !chocola.int
// CHECK-NEXT:      "chocola.return"(%6) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : () -> ()
// CHECK-NEXT:  }
