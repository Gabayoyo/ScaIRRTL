// RUN: choco-opt --dump-ast %s | filecheck %s
// RUN: choco-opt %s | choco-opt | filecheck %s --check-prefix=IR

def add(x: Int, y: Int): Int = x + y
def two(f: (Int, Int) => Int): Int = f(1, 2)
def tuple(f: ((Int, Int)) => Int): Int = f((1, 2))
def zero(): Int = 7
def invoke(f: () => Int): Int = f()
def makeAdder(x: Int): Int => Int = (y: Int) => x + y
val multi = two(add)
val oneTuple = tuple((p: (Int, Int)) => 3)
val nothing = invoke(zero)
val emptyLambda = invoke(() => 8)
val returned = makeAdder(1)(2)
val rightAssociated: Int => Int => Int = makeAdder

