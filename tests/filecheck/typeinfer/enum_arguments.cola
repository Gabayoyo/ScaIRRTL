// RUN: choco-opt --dump-ast %s | filecheck %s --check-prefix=AST
// RUN: choco-opt %s | filecheck %s --check-prefix=IR

type Wrapped = Box[Int]
enum Box[a]:
  case MkBox(value: a)
enum Tree[a]:
  case Leaf(value: a)
  case Node(left: Tree[a], right: Tree[a])
enum First[a]:
  case MkFirst(next: Second[a])
enum Second[a]:
  case MkSecond(value: a, next: List[First[a]])
def unwrap[a](b: Box[a]): a = b match
  case MkBox(x) => x
val tree = Node(Leaf(1), Leaf(2))
val wrapped: Wrapped = MkBox(7)
val matched = wrapped match
  case MkBox(v) => v + 1
val recursive = MkFirst(MkSecond(true, Nil))
val listBox = MkBox(1 :: Nil)
val listField = listBox match
  case MkBox(xs) => xs

