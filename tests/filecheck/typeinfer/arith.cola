// RUN: choco-opt --dump-ast %s | filecheck %s

// Arithmetic on ints propagates TInt.
val add = 1 + 2
val sub = 10 - 3
val mul = 3 * 4
val div = 8 / 2

// CHECK: BinOp(+,Lit(IntLit(1),Some(TInt)),Lit(IntLit(2),Some(TInt)),Some(TInt))
// CHECK: BinOp(-,Lit(IntLit(10),Some(TInt)),Lit(IntLit(3),Some(TInt)),Some(TInt))
// CHECK: BinOp(*,Lit(IntLit(3),Some(TInt)),Lit(IntLit(4),Some(TInt)),Some(TInt))
// CHECK: BinOp(/,Lit(IntLit(8),Some(TInt)),Lit(IntLit(2),Some(TInt)),Some(TInt))
