// RUN: choco-opt %s | filecheck %s
// IR-level: cons op result is !chocola.list<!elem>.

val xs = 1 :: 2 :: Nil

// CHECK:       builtin.module {
// CHECK-NEXT:    %0 = "chocola.constant"() <{value = "1"}> : () -> !chocola.int
// CHECK-NEXT:    %1 = "chocola.constant"() <{value = "2"}> : () -> !chocola.int
// CHECK-NEXT:    %2 = "chocola.constant"() <{value = "Nil"}> : () -> !chocola.list<!chocola.int>
// CHECK-NEXT:    %3 = "chocola.cons"(%1, %2) : (!chocola.int, !chocola.list<!chocola.int>) -> !chocola.list<!chocola.int>
// CHECK-NEXT:    %4 = "chocola.cons"(%0, %3) : (!chocola.int, !chocola.list<!chocola.int>) -> !chocola.list<!chocola.int>
// CHECK-NEXT:    "chocola.func"() <{sym = @main, typeParams = [], functionType = () -> !chocola.int}> ({
// CHECK-NEXT:      %5 = "chocola.constant"() <{value = "0"}> : () -> !chocola.int
// CHECK-NEXT:      "chocola.return"(%5) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : () -> ()
// CHECK-NEXT:  }
