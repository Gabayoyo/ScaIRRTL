// RUN: choco-opt --dump-ast %s | filecheck %s

// DefDecl: parameter types explicit; body inferred and checked against return type.
// The binding for the function name gets the curried TFun type.
def inc(x: Int): Int = x + 1
def add(x: Int, y: Int): Int = x + y

// Body of inc: x has TInt, x+1 has TInt.
// CHECK: DefDecl(inc,List(),List((x,TInt)),TInt,BinOp(+,Var(x,Some(TInt)),Lit(IntLit(1),Some(TInt)),Some(TInt)))
// Body of add: both params TInt, result TInt.
// CHECK: DefDecl(add,List(),List((x,TInt), (y,TInt)),TInt,BinOp(+,Var(x,Some(TInt)),Var(y,Some(TInt)),Some(TInt)))
