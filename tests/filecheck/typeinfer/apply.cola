// RUN: choco-opt --dump-ast %s | filecheck %s

// Function application peels TFun layers: result type is the codomain.
def double(x: Int): Int = x * 2
val r = double(21)

// The Apply result type is TInt (codomain of TFun(TInt, TInt)).
// CHECK: Apply(Var(double,Some(TFun(TInt,TInt))),List(Lit(IntLit(21),Some(TInt))),Some(TInt))
