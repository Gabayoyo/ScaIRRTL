// RUN: choco-opt --parsing-diagnostics --dump-ast %s | filecheck %s

enum Bad:
  case Field(value: List)

// CHECK:       Parsing succeeded.
// CHECK-NEXT:  {{.*}}/error_declarations_list_arity.cola:4:3-26: Type error: Type List expects 1 type arguments, got 0
