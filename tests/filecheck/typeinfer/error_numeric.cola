// RUN: choco-opt --parsing-diagnostics --dump-ast %s 2>&1 | filecheck %s
// Arithmetic operators require int or double operands (T-Add et al.); this
// wasn't checked at all before the rewrite, so "a" + "b" used to type-check.

val bad = "a" + "b"

// CHECK: Parsing succeeded.
// CHECK: {{.*}}error_numeric.cola:5:11-20: Type error: Expected int or double in arithmetic, got TString
