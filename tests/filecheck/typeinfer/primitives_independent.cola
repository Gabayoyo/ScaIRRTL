// RUN: choco-opt --dump-ast %s | filecheck %s
// map/filter/foldLeft/foldRight each instantiate their scheme independently
// (via Scheme + instantiate): two calls to the same primitive in one program
// must not share metavariables, so they can be used here at unrelated
// concrete types without interfering with each other.

def inc(x: Int): Int = x + 1
def len(s: String): Int = 0
def isPos(x: Int): Bool = x > 0

val ints = map(inc, 1 :: 2 :: Nil)
val lens = map(len, "a" :: "bb" :: Nil)

val kept = filter(1 :: 2 :: Nil, isPos)

// CHECK: Parsing succeeded.
// CHECK: ValDecl(ints,Apply(Lit(MapPrim,Some(TFun(List(TFun(List(TInt),TInt), TList(TInt)),TList(TInt)))),List(Var(inc,Some(TFun(List(TInt),TInt))), BinOp(::,Lit(IntLit(1),Some(TInt)),BinOp(::,Lit(IntLit(2),Some(TInt)),Lit(NilLit,Some(TList(TInt))),Some(TList(TInt))),Some(TList(TInt)))),Some(TList(TInt))),None)
// CHECK: ValDecl(lens,Apply(Lit(MapPrim,Some(TFun(List(TFun(List(TString),TInt), TList(TString)),TList(TInt)))),List(Var(len,Some(TFun(List(TString),TInt))), BinOp(::,Lit(StrLit(a),Some(TString)),BinOp(::,Lit(StrLit(bb),Some(TString)),Lit(NilLit,Some(TList(TString))),Some(TList(TString))),Some(TList(TString)))),Some(TList(TInt))),None)
// CHECK: ValDecl(kept,Apply(Lit(FilterPrim,Some(TFun(List(TList(TInt), TFun(List(TInt),TBool)),TList(TInt)))),List(BinOp(::,Lit(IntLit(1),Some(TInt)),BinOp(::,Lit(IntLit(2),Some(TInt)),Lit(NilLit,Some(TList(TInt))),Some(TList(TInt))),Some(TList(TInt))), Var(isPos,Some(TFun(List(TInt),TBool)))),Some(TList(TInt))),None)
