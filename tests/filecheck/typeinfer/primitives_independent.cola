// RUN: choco-opt --dump-ast %s | filecheck %s
// map/filter/foldLeft/foldRight each instantiate their scheme independently
// (via Scheme + instantiate): two calls to the same primitive in one program
// must not share metavariables, so they can be used here at unrelated
// concrete types without interfering with each other.

def inc(x: Int): Int = x + 1
def len(s: String): Int = 0
def isPos(x: Int): Bool = x > 0

val ints = map(inc, 1 :: 2 :: Nil)
val lens = map(len, "a" :: "bb" :: Nil)

val kept = filter(1 :: 2 :: Nil, isPos)

// CHECK: Parsing succeeded.
// CHECK: ValDecl(ints,Apply(Lit(MapPrim,Some(TFun(TFun(TInt,TInt),TFun(TList(TInt),TList(TInt))))),List(Var(inc,Some(TFun(TInt,TInt))), BinOp(::,Lit(IntLit(1),Some(TInt)),BinOp(::,Lit(IntLit(2),Some(TInt)),Lit(NilLit,Some(TList(TInt))),Some(TList(TInt))),Some(TList(TInt)))),Some(TList(TInt))))
// CHECK: ValDecl(lens,Apply(Lit(MapPrim,Some(TFun(TFun(TString,TInt),TFun(TList(TString),TList(TInt))))),List(Var(len,Some(TFun(TString,TInt))), BinOp(::,Lit(StrLit(a),Some(TString)),BinOp(::,Lit(StrLit(bb),Some(TString)),Lit(NilLit,Some(TList(TString))),Some(TList(TString))),Some(TList(TString)))),Some(TList(TInt))))
// CHECK: ValDecl(kept,Apply(Lit(FilterPrim,Some(TFun(TList(TInt),TFun(TFun(TInt,TBool),TList(TInt))))),List(BinOp(::,Lit(IntLit(1),Some(TInt)),BinOp(::,Lit(IntLit(2),Some(TInt)),Lit(NilLit,Some(TList(TInt))),Some(TList(TInt))),Some(TList(TInt))), Var(isPos,Some(TFun(TInt,TBool)))),Some(TList(TInt))))
