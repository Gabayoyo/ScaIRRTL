// RUN: choco-opt --dump-ast %s | filecheck %s
// Each constructor instantiates fresh arguments and matching substitutes them.

enum Box[a]:
  case MkBox(value: a)

val bi = MkBox(1)
val bs = MkBox(true)

// The concrete field type propagates from the constructed scrutinee.
val unwrapped = MkBox(7) match
  case MkBox(v) => v

// CHECK: Parsing succeeded.
// CHECK: EnumDecl(Box,List(a),List(EnumCase(MkBox,List((value,TName(a,List()))))))
// CHECK: ValDecl(bi,Construct(MkBox,List(Lit(IntLit(1),Some(TInt))),Some(TName(Box,List(TInt)))),None)
// CHECK: ValDecl(bs,Construct(MkBox,List(Lit(BoolLit(true),Some(TBool))),Some(TName(Box,List(TBool)))),None)
// CHECK: ValDecl(unwrapped,Match(Construct(MkBox,List(Lit(IntLit(7),Some(TInt))),Some(TName(Box,List(TInt)))),List(MatchCase(MkBox,List(v),Var(v,Some(TInt)))),Some(TInt)),None)
