// RUN: choco-opt --dump-ast %s | filecheck %s

def left(acc: Int, s: String): Int = acc + 1
def right(s: String, acc: Int): Int = acc + 1
val l = foldLeft("a" :: Nil, 0, left)
val r = foldRight("b" :: Nil, 0, right)
val otherLeft = foldLeft(1 :: Nil, true, (acc: Bool, i: Int) => acc)
val otherRight = foldRight(2 :: Nil, true, (i: Int, acc: Bool) => acc)

// CHECK:       Parsing succeeded.
// CHECK-NEXT:  Program(List(DefDecl(left,List(),List((acc,TInt), (s,TString)),TInt,BinOp(+,Var(acc,Some(TInt)),Lit(IntLit(1),Some(TInt)),Some(TInt))), DefDecl(right,List(),List((s,TString), (acc,TInt)),TInt,BinOp(+,Var(acc,Some(TInt)),Lit(IntLit(1),Some(TInt)),Some(TInt))), ValDecl(l,Apply(Lit(FoldLeftPrim,Some(TFun(List(TList(TString), TInt, TFun(List(TInt, TString),TInt)),TInt))),List(BinOp(::,Lit(StrLit(a),Some(TString)),Lit(NilLit,Some(TList(TString))),Some(TList(TString))), Lit(IntLit(0),Some(TInt)), Var(left,Some(TFun(List(TInt, TString),TInt)))),Some(TInt)),None), ValDecl(r,Apply(Lit(FoldRightPrim,Some(TFun(List(TList(TString), TInt, TFun(List(TString, TInt),TInt)),TInt))),List(BinOp(::,Lit(StrLit(b),Some(TString)),Lit(NilLit,Some(TList(TString))),Some(TList(TString))), Lit(IntLit(0),Some(TInt)), Var(right,Some(TFun(List(TString, TInt),TInt)))),Some(TInt)),None), ValDecl(otherLeft,Apply(Lit(FoldLeftPrim,Some(TFun(List(TList(TInt), TBool, TFun(List(TBool, TInt),TBool)),TBool))),List(BinOp(::,Lit(IntLit(1),Some(TInt)),Lit(NilLit,Some(TList(TInt))),Some(TList(TInt))), Lit(BoolLit(true),Some(TBool)), Lambda(List((acc,TBool), (i,TInt)),Var(acc,Some(TBool)),Some(TFun(List(TBool, TInt),TBool)))),Some(TBool)),None), ValDecl(otherRight,Apply(Lit(FoldRightPrim,Some(TFun(List(TList(TInt), TBool, TFun(List(TInt, TBool),TBool)),TBool))),List(BinOp(::,Lit(IntLit(2),Some(TInt)),Lit(NilLit,Some(TList(TInt))),Some(TList(TInt))), Lit(BoolLit(true),Some(TBool)), Lambda(List((i,TInt), (acc,TBool)),Var(acc,Some(TBool)),Some(TFun(List(TInt, TBool),TBool)))),Some(TBool)),None)),None)
