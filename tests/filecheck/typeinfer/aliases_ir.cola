// RUN: choco-opt %s | choco-opt | filecheck %s
// RUN: choco-opt --passes=convert-choco-to-mlir %s | filecheck %s --check-prefix=LOWER

type Forward = Num
type Num = Int
def increment(x: Forward): Num = x + 1
val f = (x: Num) => x + 2
val annotated: Forward = increment(3)
f(annotated)

// CHECK:       builtin.module {
// CHECK-NEXT:    "chocola.type_alias"() <{sym = @Forward, aliased = !chocola.int}> : () -> ()
// CHECK-NEXT:    "chocola.type_alias"() <{sym = @Num, aliased = !chocola.int}> : () -> ()
// CHECK-NEXT:    "chocola.func"() <{sym = @increment, typeParams = [], functionType = (!chocola.int) -> !chocola.int}> ({
// CHECK-NEXT:    ^bb0(%0: !chocola.int):
// CHECK-NEXT:      %1 = "chocola.constant"() <{value = "1"}> : () -> !chocola.int
// CHECK-NEXT:      %2 = "chocola.add"(%0, %1) : (!chocola.int, !chocola.int) -> !chocola.int
// CHECK-NEXT:      "chocola.return"(%2) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : () -> ()
// CHECK-NEXT:    %0 = "chocola.lambda"() ({
// CHECK-NEXT:    ^bb0(%1: !chocola.int):
// CHECK-NEXT:      %2 = "chocola.constant"() <{value = "2"}> : () -> !chocola.int
// CHECK-NEXT:      %3 = "chocola.add"(%1, %2) : (!chocola.int, !chocola.int) -> !chocola.int
// CHECK-NEXT:      "chocola.yield"(%3) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : () -> !chocola.fun<[!chocola.int], !chocola.int>
// CHECK-NEXT:    %1 = "chocola.constant"() <{value = "3"}> : () -> !chocola.int
// CHECK-NEXT:    %2 = "chocola.direct_call"(%1) <{callee = @increment}> : (!chocola.int) -> !chocola.int
// CHECK-NEXT:    "chocola.func"() <{sym = @main, typeParams = [], functionType = () -> !chocola.int}> ({
// CHECK-NEXT:      %3 = "chocola.call"(%0, %2) : (!chocola.fun<[!chocola.int], !chocola.int>, !chocola.int) -> !chocola.int
// CHECK-NEXT:      "chocola.return"(%3) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : () -> ()
// CHECK-NEXT:  }

// LOWER:       builtin.module {
// LOWER-NEXT:    "chocola.type_alias"() <{sym = @Forward, aliased = !chocola.int}> : () -> ()
// LOWER-NEXT:    "chocola.type_alias"() <{sym = @Num, aliased = !chocola.int}> : () -> ()
// LOWER-NEXT:    func.func @increment(%0: i32) -> i32 {
// LOWER-NEXT:      %1 = "arith.constant"() <{value = 1 : i32}> : () -> i32
// LOWER-NEXT:      %2 = "arith.addi"(%0, %1) <{overflowFlags = #arith.overflow<none>}> : (i32, i32) -> i32
// LOWER-NEXT:      func.return %2 : i32
// LOWER-NEXT:    }
// LOWER-NEXT:    %0 = "chocola.lambda"() ({
// LOWER-NEXT:    ^bb0(%1: !chocola.int):
// LOWER-NEXT:      %2 = "builtin.unrealized_conversion_cast"(%1) : (!chocola.int) -> i32
// LOWER-NEXT:      %3 = "arith.constant"() <{value = 2 : i32}> : () -> i32
// LOWER-NEXT:      %4 = "arith.addi"(%2, %3) <{overflowFlags = #arith.overflow<none>}> : (i32, i32) -> i32
// LOWER-NEXT:      %5 = "builtin.unrealized_conversion_cast"(%4) : (i32) -> !chocola.int
// LOWER-NEXT:      "chocola.yield"(%5) : (!chocola.int) -> ()
// LOWER-NEXT:    }) : () -> !chocola.fun<[!chocola.int], !chocola.int>
// LOWER-NEXT:    %1 = "arith.constant"() <{value = 3 : i32}> : () -> i32
// LOWER-NEXT:    %2 = "func.call"(%1) <{callee = @increment}> : (i32) -> i32
// LOWER-NEXT:    %3 = "builtin.unrealized_conversion_cast"(%2) : (i32) -> !chocola.int
// LOWER-NEXT:    "chocola.func"() <{sym = @main, typeParams = [], functionType = () -> !chocola.int}> ({
// LOWER-NEXT:      %4 = "chocola.call"(%0, %3) : (!chocola.fun<[!chocola.int], !chocola.int>, !chocola.int) -> !chocola.int
// LOWER-NEXT:      "chocola.return"(%4) : (!chocola.int) -> ()
// LOWER-NEXT:    }) : () -> ()
// LOWER-NEXT:  }
