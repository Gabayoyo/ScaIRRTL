// RUN: choco-opt --dump-ast %s 2>&1 | filecheck %s
// Arity mismatches are reported for both function over-application and
// enum Construct (too few/too many args vs. declared fields).

def add(x: Int, y: Int): Int = x + y
val bad1 = add(1, 2, 3)

enum Pair {
  case MkPair(a: Int, b: Int)
}
val bad2 = MkPair(1)

// CHECK: Parsing succeeded.
// CHECK: Type error: Applying non-function type: TInt
// CHECK: Type error: Constructor MkPair expects 2 args, got 1
