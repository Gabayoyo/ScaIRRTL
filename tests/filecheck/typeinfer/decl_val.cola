// RUN: choco-opt --dump-ast %s | filecheck %s

// ValDecl binds a name to the inferred type of the body.
// Subsequent uses of the name carry the bound type.
val x = 42
val y = x + 1

// CHECK: ValDecl(x,Lit(IntLit(42),Some(TInt)))
// x is in scope with TInt, so Var(x) gets Some(TInt).
// CHECK: ValDecl(y,BinOp(+,Var(x,Some(TInt)),Lit(IntLit(1),Some(TInt)),Some(TInt)))
