// RUN: choco-opt --dump-ast %s 2>&1 | filecheck %s
// Referencing an undeclared variable is a type error (not a parse error);
// inference recovers with a fresh metavariable so the rest of the program
// still gets checked (Main.scala keeps type errors non-fatal).

val x = unboundName

// CHECK: Parsing succeeded.
// CHECK: Type error: Unbound variable: unboundName
