// RUN: choco-opt --dump-ast %s | filecheck %s

// Arithmetic
val add = 1 + 2
val mul = 3 * 4
// Precedence: * binds tighter than +, so 1 + 2 * 3 = 1 + (2 * 3)
val prec = 1 + 2 * 3

// Comparison
val lt = 1 < 2
val eq = 1 == 1

// Boolean
val andExpr = true && false
val orExpr  = true || false
val notExpr = !true

// List cons (right-associative: 1 :: 2 :: Nil = 1 :: (2 :: Nil))
val lst = 1 :: 2 :: Nil

// CHECK: Parsing succeeded.
// CHECK: ValDecl(add,BinOp(+,Lit(IntLit(1),Some(TInt)),Lit(IntLit(2),Some(TInt)),Some(TInt)))
// CHECK: ValDecl(mul,BinOp(*,Lit(IntLit(3),Some(TInt)),Lit(IntLit(4),Some(TInt)),Some(TInt)))
// CHECK: ValDecl(prec,BinOp(+,Lit(IntLit(1),Some(TInt)),BinOp(*,Lit(IntLit(2),Some(TInt)),Lit(IntLit(3),Some(TInt)),Some(TInt)),Some(TInt)))
// CHECK: ValDecl(lt,BinOp(<,Lit(IntLit(1),Some(TInt)),Lit(IntLit(2),Some(TInt)),Some(TBool)))
// CHECK: ValDecl(eq,BinOp(==,Lit(IntLit(1),Some(TInt)),Lit(IntLit(1),Some(TInt)),Some(TBool)))
// CHECK: ValDecl(andExpr,BinOp(&&,Lit(BoolLit(true),Some(TBool)),Lit(BoolLit(false),Some(TBool)),Some(TBool)))
// CHECK: ValDecl(orExpr,BinOp(||,Lit(BoolLit(true),Some(TBool)),Lit(BoolLit(false),Some(TBool)),Some(TBool)))
// CHECK: ValDecl(notExpr,UnOp(!,Lit(BoolLit(true),Some(TBool)),Some(TBool)))
// CHECK: ValDecl(lst,BinOp(::,Lit(IntLit(1),Some(TInt)),BinOp(::,Lit(IntLit(2),Some(TInt)),Lit(NilLit,Some(TList(TInt))),Some(TList(TInt))),Some(TList(TInt))))
