// RUN: choco-opt --parsing-diagnostics --dump-ast %s | filecheck %s

// Missing binding name: `val = 42` is not valid syntax.
val = 42

// CHECK: {{.*}}bad_syntax.cola:4:5: Parse error: expected variable name
// CHECK-NEXT: val = 42
// CHECK-NEXT:     ^
// CHECK-NEXT: Parsing failed.

// RUN: choco-opt --parsing-diagnostics %s | filecheck %s --check-prefix=DIAG
// RUN: choco-opt --dump-ast --parsing-diagnostics %s | filecheck %s --check-prefix=DIAG
// DIAG: Parse error: expected variable name
