// RUN: choco-opt --dump-ast --parsing-diagnostics %s | filecheck %s

enum Box:
  case Wrap(value: Int)
  case Empty()
val x = Wrap(1) match
  case Wrap(v) => Wrap(v) match
    case Wrap(w) => w
   case Empty() => 0
  case Empty() => 0

// CHECK:       {{.*}}/layout_nested_case.cola:9:4: Parse error: expected an aligned case, dedentation, or an enclosing delimiter
// CHECK-NEXT:     case Empty() => 0
