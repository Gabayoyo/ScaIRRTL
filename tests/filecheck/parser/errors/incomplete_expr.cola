// RUN: choco-opt --parsing-diagnostics --dump-ast %s | filecheck %s

// A binary operator with no right-hand side is not a valid expression.
val x = 1 +

// CHECK:       {{.*}}/incomplete_expr.cola:5:1: Parse error: expected continued operand indented at least 1 spaces

// CHECK:       ^
// CHECK-NEXT:  Parsing failed.
