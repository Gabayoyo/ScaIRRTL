// RUN: choco-opt --dump-ast %s | filecheck %s

enum Box:
  case Wrap(value:
Int
)

def add(
x: Int,
y: Int
): Int = x + y

type Callback = (
Int,
Int
) => Int

val callback: Callback = (
x: Int,
y: Int
) =>
  x + y

val mixed = add(
  if true then
    1
  else
    2,
  Wrap(3) match
    case Wrap(v) => v)
val pair = (
  Wrap(mixed) match
    case Wrap(v) => v,
  callback(
4,
5
))

