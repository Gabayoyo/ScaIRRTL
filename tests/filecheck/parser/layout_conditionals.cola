// RUN: choco-opt --dump-ast %s | filecheck %s

val nested =
  if true then
    if false then
      1
    else
      2
  else
    if true then 3 else 4

val condition = if
  true
then
  nested
else
  0

condition

// CHECK:       Parsing succeeded.
// CHECK-NEXT:  Program(List(ValDecl(nested,If(Lit(BoolLit(true),Some(TBool)),If(Lit(BoolLit(false),Some(TBool)),Lit(IntLit(1),Some(TInt)),Lit(IntLit(2),Some(TInt)),Some(TInt)),If(Lit(BoolLit(true),Some(TBool)),Lit(IntLit(3),Some(TInt)),Lit(IntLit(4),Some(TInt)),Some(TInt)),Some(TInt)),None), ValDecl(condition,If(Lit(BoolLit(true),Some(TBool)),Var(nested,Some(TInt)),Lit(IntLit(0),Some(TInt)),Some(TInt)),None)),Some(Var(condition,Some(TInt))))
