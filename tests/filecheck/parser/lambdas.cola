// RUN: choco-opt --dump-ast %s | filecheck %s

// Single-parameter lambda
val double = (x: Int) => x * 2

// Multi-parameter lambda
val add = (x: Int, y: Int) => x + y

// Lambda applied immediately (function call postfix)
val result = (x: Int) => x + 1

// Tuple expression (distinct from lambda: no type annotations, no =>)
val pair = (1, 2)
val triple = (1, 2, 3)

// CHECK: Parsing succeeded.
// CHECK: ValDecl(double,Lambda(List((x,TInt)),BinOp(*,Var(x,Some(TInt)),Lit(IntLit(2),Some(TInt)),Some(TInt)),Some(TFun(TInt,TInt))))
// CHECK: ValDecl(add,Lambda(List((x,TInt), (y,TInt)),BinOp(+,Var(x,Some(TInt)),Var(y,Some(TInt)),Some(TInt)),Some(TFun(TInt,TFun(TInt,TInt)))))
// CHECK: ValDecl(result,Lambda(List((x,TInt)),BinOp(+,Var(x,Some(TInt)),Lit(IntLit(1),Some(TInt)),Some(TInt)),Some(TFun(TInt,TInt))))
// CHECK: ValDecl(pair,Tuple(List(Lit(IntLit(1),Some(TInt)), Lit(IntLit(2),Some(TInt))),Some(TTuple(List(TInt, TInt)))))
// CHECK: ValDecl(triple,Tuple(List(Lit(IntLit(1),Some(TInt)), Lit(IntLit(2),Some(TInt)), Lit(IntLit(3),Some(TInt))),Some(TTuple(List(TInt, TInt, TInt)))))
