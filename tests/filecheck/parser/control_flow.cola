// RUN: choco-opt --dump-ast %s | filecheck %s

// if-then-else is an expression
val x = if true then 1 else 0

// Nested if
val y = if 1 < 2 then if true then 10 else 20 else 30

// enum for use in match
enum Shape {
  case Circle(r: Int)
  case Rect(w: Int, h: Int)
}

// match is a postfix expression on any expression
val area = Circle(5) match {
  case Circle(r) => r * r
  case Rect(w, h) => w * h
}

// CHECK: Parsing succeeded.
// CHECK: ValDecl(x,If(Lit(BoolLit(true)),Lit(IntLit(1)),Lit(IntLit(0))))
// CHECK: ValDecl(y,If(BinOp(<,Lit(IntLit(1)),Lit(IntLit(2))),If(Lit(BoolLit(true)),Lit(IntLit(10)),Lit(IntLit(20))),Lit(IntLit(30))))
// CHECK: EnumDecl(Shape,List(),List(EnumCase(Circle,List((r,TInt))), EnumCase(Rect,List((w,TInt), (h,TInt)))))
// CHECK: ValDecl(area,Match(Construct(Circle,List(Lit(IntLit(5)))),List(MatchCase(Circle,List(r),BinOp(*,Var(r),Var(r))), MatchCase(Rect,List(w, h),BinOp(*,Var(w),Var(h))))))
