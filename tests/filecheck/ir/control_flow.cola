// RUN: choco-opt %s | filecheck %s

val x = if true then 1 else 0
val y = if 1 < 2 then if true then 10 else 20 else 30

enum Shape {
  case Circle(r: Int)
  case Rect(w: Int, h: Int)
}

val area = Circle(5) match {
  case Circle(r) => r * r
  case Rect(w, h) => w * h
}

// CHECK:       builtin.module {
// CHECK-NEXT:    %0 = "chocola.constant"() <{value = "true"}> : () -> !chocola.bool
// CHECK-NEXT:    %1 = "chocola.if"(%0) ({
// CHECK-NEXT:      %2 = "chocola.constant"() <{value = "1"}> : () -> !chocola.int
// CHECK-NEXT:      "chocola.yield"(%2) : (!chocola.int) -> ()
// CHECK-NEXT:    }, {
// CHECK-NEXT:      %2 = "chocola.constant"() <{value = "0"}> : () -> !chocola.int
// CHECK-NEXT:      "chocola.yield"(%2) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : (!chocola.bool) -> !chocola.int
// CHECK-NEXT:    %2 = "chocola.constant"() <{value = "1"}> : () -> !chocola.int
// CHECK-NEXT:    %3 = "chocola.constant"() <{value = "2"}> : () -> !chocola.int
// CHECK-NEXT:    %4 = "chocola.lt"(%2, %3) : (!chocola.int, !chocola.int) -> !chocola.bool
// CHECK-NEXT:    %5 = "chocola.if"(%4) ({
// CHECK-NEXT:      %6 = "chocola.constant"() <{value = "true"}> : () -> !chocola.bool
// CHECK-NEXT:      %7 = "chocola.if"(%6) ({
// CHECK-NEXT:        %8 = "chocola.constant"() <{value = "10"}> : () -> !chocola.int
// CHECK-NEXT:        "chocola.yield"(%8) : (!chocola.int) -> ()
// CHECK-NEXT:      }, {
// CHECK-NEXT:        %8 = "chocola.constant"() <{value = "20"}> : () -> !chocola.int
// CHECK-NEXT:        "chocola.yield"(%8) : (!chocola.int) -> ()
// CHECK-NEXT:      }) : (!chocola.bool) -> !chocola.int
// CHECK-NEXT:      "chocola.yield"(%7) : (!chocola.int) -> ()
// CHECK-NEXT:    }, {
// CHECK-NEXT:      %6 = "chocola.constant"() <{value = "30"}> : () -> !chocola.int
// CHECK-NEXT:      "chocola.yield"(%6) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : (!chocola.bool) -> !chocola.int
// CHECK-NEXT:    "chocola.enum"() <{sym = @Shape, typeParams = []}> ({
// CHECK-NEXT:      "chocola.enum_case"() <{sym = @Circle, fields = [#chocola.enum_field<@r, !chocola.int>]}> : () -> ()
// CHECK-NEXT:      "chocola.enum_case"() <{sym = @Rect, fields = [#chocola.enum_field<@w, !chocola.int>, #chocola.enum_field<@h, !chocola.int>]}> : () -> ()
// CHECK-NEXT:    }) : () -> ()
// CHECK-NEXT:    %6 = "chocola.constant"() <{value = "5"}> : () -> !chocola.int
// CHECK-NEXT:    %7 = "chocola.construct"(%6) <{ctor = @Circle}> : (!chocola.int) -> !chocola.named<@Shape>
// CHECK-NEXT:    %8 = "chocola.match"(%7) ({
// CHECK-NEXT:      "chocola.case"() <{ctor = @Circle}> ({
// CHECK-NEXT:      ^bb0(%9: !chocola.int):
// CHECK-NEXT:        %10 = "chocola.mul"(%9, %9) : (!chocola.int, !chocola.int) -> !chocola.int
// CHECK-NEXT:        "chocola.yield"(%10) : (!chocola.int) -> ()
// CHECK-NEXT:      }) : () -> ()
// CHECK-NEXT:      "chocola.case"() <{ctor = @Rect}> ({
// CHECK-NEXT:      ^bb0(%9: !chocola.int, %10: !chocola.int):
// CHECK-NEXT:        %11 = "chocola.mul"(%9, %10) : (!chocola.int, !chocola.int) -> !chocola.int
// CHECK-NEXT:        "chocola.yield"(%11) : (!chocola.int) -> ()
// CHECK-NEXT:      }) : () -> ()
// CHECK-NEXT:    }) : (!chocola.named<@Shape>) -> !chocola.int
// CHECK-NEXT:    "chocola.func"() <{sym = @main, typeParams = [], functionType = () -> !chocola.int}> ({
// CHECK-NEXT:      %9 = "chocola.constant"() <{value = "0"}> : () -> !chocola.int
// CHECK-NEXT:      "chocola.return"(%9) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : () -> ()
// CHECK-NEXT:  }
