// RUN: choco-opt %s | filecheck %s

val add = 1 + 2
val mul = 3 * 4
val prec = 1 + 2 * 3
val lt = 1 < 2
val eq = 1 == 1
val andExpr = true && false
val orExpr  = true || false
val notExpr = !true
val lst = 1 :: 2 :: Nil

