// RUN: choco-opt %s | filecheck %s

val add = 1 + 2
val mul = 3 * 4
val prec = 1 + 2 * 3
val lt = 1 < 2
val eq = 1 == 1
val andExpr = true && false
val orExpr  = true || false
val notExpr = !true
val lst = 1 :: 2 :: Nil

// CHECK: Parsing succeeded.
// CHECK: "chocola.binop"(%0, %1) <{op = "+"}> : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.binop"(%2, %3) <{op = "*"}> : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.binop"(%4, %5) <{op = "*"}> : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.binop"(%6, %7) <{op = "+"}> : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.binop"(%8, %9) <{op = "<"}> : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.binop"(%10, %11) <{op = "=="}> : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.binop"(%12, %13) <{op = "&&"}> : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.binop"(%14, %15) <{op = "||"}> : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.unary"(%16) <{op = "!"}> : (!chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.binop"(%17, %18) <{op = "::"}> : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.binop"(%19, %20) <{op = "::"}> : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
