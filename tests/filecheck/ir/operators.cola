// RUN: choco-opt %s | filecheck %s

val add = 1 + 2
val mul = 3 * 4
val prec = 1 + 2 * 3
val lt = 1 < 2
val eq = 1 == 1
val andExpr = true && false
val orExpr  = true || false
val notExpr = !true
val lst = 1 :: 2 :: Nil

// CHECK: Parsing succeeded.
// CHECK: "chocola.add"(%0, %1) : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.mul"(%2, %3) : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.mul"(%4, %5) : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.add"(%6, %7) : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.lt"(%8, %9) : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.eq"(%10, %11) : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.and"(%12, %13) : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.or"(%14, %15) : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.not"(%16) : (!chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.cons"(%17, %18) : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK: "chocola.cons"(%19, %20) : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
