// RUN: choco-opt %s | filecheck %s

val add = 1 + 2
val mul = 3 * 4
val prec = 1 + 2 * 3
val lt = 1 < 2
val eq = 1 == 1
val andExpr = true && false
val orExpr  = true || false
val notExpr = !true
val lst = 1 :: 2 :: Nil

// CHECK:       builtin.module {
// CHECK-NEXT:    %0 = "chocola.constant"() <{value = "1"}> : () -> !chocola.int
// CHECK-NEXT:    %1 = "chocola.constant"() <{value = "2"}> : () -> !chocola.int
// CHECK-NEXT:    %2 = "chocola.add"(%0, %1) : (!chocola.int, !chocola.int) -> !chocola.int
// CHECK-NEXT:    %3 = "chocola.constant"() <{value = "3"}> : () -> !chocola.int
// CHECK-NEXT:    %4 = "chocola.constant"() <{value = "4"}> : () -> !chocola.int
// CHECK-NEXT:    %5 = "chocola.mul"(%3, %4) : (!chocola.int, !chocola.int) -> !chocola.int
// CHECK-NEXT:    %6 = "chocola.constant"() <{value = "1"}> : () -> !chocola.int
// CHECK-NEXT:    %7 = "chocola.constant"() <{value = "2"}> : () -> !chocola.int
// CHECK-NEXT:    %8 = "chocola.constant"() <{value = "3"}> : () -> !chocola.int
// CHECK-NEXT:    %9 = "chocola.mul"(%7, %8) : (!chocola.int, !chocola.int) -> !chocola.int
// CHECK-NEXT:    %10 = "chocola.add"(%6, %9) : (!chocola.int, !chocola.int) -> !chocola.int
// CHECK-NEXT:    %11 = "chocola.constant"() <{value = "1"}> : () -> !chocola.int
// CHECK-NEXT:    %12 = "chocola.constant"() <{value = "2"}> : () -> !chocola.int
// CHECK-NEXT:    %13 = "chocola.lt"(%11, %12) : (!chocola.int, !chocola.int) -> !chocola.bool
// CHECK-NEXT:    %14 = "chocola.constant"() <{value = "1"}> : () -> !chocola.int
// CHECK-NEXT:    %15 = "chocola.constant"() <{value = "1"}> : () -> !chocola.int
// CHECK-NEXT:    %16 = "chocola.eq"(%14, %15) : (!chocola.int, !chocola.int) -> !chocola.bool
// CHECK-NEXT:    %17 = "chocola.constant"() <{value = "true"}> : () -> !chocola.bool
// CHECK-NEXT:    %18 = "chocola.constant"() <{value = "false"}> : () -> !chocola.bool
// CHECK-NEXT:    %19 = "chocola.and"(%17, %18) : (!chocola.bool, !chocola.bool) -> !chocola.bool
// CHECK-NEXT:    %20 = "chocola.constant"() <{value = "true"}> : () -> !chocola.bool
// CHECK-NEXT:    %21 = "chocola.constant"() <{value = "false"}> : () -> !chocola.bool
// CHECK-NEXT:    %22 = "chocola.or"(%20, %21) : (!chocola.bool, !chocola.bool) -> !chocola.bool
// CHECK-NEXT:    %23 = "chocola.constant"() <{value = "true"}> : () -> !chocola.bool
// CHECK-NEXT:    %24 = "chocola.not"(%23) : (!chocola.bool) -> !chocola.bool
// CHECK-NEXT:    %25 = "chocola.constant"() <{value = "1"}> : () -> !chocola.int
// CHECK-NEXT:    %26 = "chocola.constant"() <{value = "2"}> : () -> !chocola.int
// CHECK-NEXT:    %27 = "chocola.constant"() <{value = "Nil"}> : () -> !chocola.list<!chocola.int>
// CHECK-NEXT:    %28 = "chocola.cons"(%26, %27) : (!chocola.int, !chocola.list<!chocola.int>) -> !chocola.list<!chocola.int>
// CHECK-NEXT:    %29 = "chocola.cons"(%25, %28) : (!chocola.int, !chocola.list<!chocola.int>) -> !chocola.list<!chocola.int>
// CHECK-NEXT:    "chocola.func"() <{sym = @main, typeParams = [], functionType = () -> !chocola.int}> ({
// CHECK-NEXT:      %30 = "chocola.constant"() <{value = "0"}> : () -> !chocola.int
// CHECK-NEXT:      "chocola.return"(%30) : (!chocola.int) -> ()
// CHECK-NEXT:    }) : () -> ()
// CHECK-NEXT:  }
