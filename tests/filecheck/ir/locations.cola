// RUN: cd %S && choco-opt --print-locations locations.cola | filecheck %s

type Num = Int

enum Shape:
  case Circle(r: Int)
  case Rect(w: Int, h: Int)

def area(s: Shape): Int = s match
  case Circle(r) => r * r
  case Rect(w, h) => w * h

val inc = (x: Int) => x + 1
val pair = (inc(-2), !true)

def add(x: Int): Int => Int = (y: Int) => x + y

val arith = 1 + 2 * 3 - 4
val list = 1 :: 2 :: Nil
val curried = add(1)(2)

if area(Rect(2, 3)) > 5 then area(Circle(2)) else 0

