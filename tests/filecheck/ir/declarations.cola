// RUN: choco-opt %s | filecheck %s

type MyInt = Int
def double(x: Int): Int = x * 2
def identity[a](x: a): a = x
def add(x: Int, y: Int): Int = x + y

enum Color {
  case Red()
  case Green()
  case Blue()
}

enum Tree[a] {
  case Leaf(value: a)
  case Node(left: Tree, right: Tree)
}

// CHECK: Parsing succeeded.
// CHECK: "chocola.type_alias"() <{sym = "MyInt", aliased = "TInt"}> : () -> ()
// CHECK: "chocola.func"() <{sym = "double"}> ({
// CHECK: ^bb0(%0: !chocola.unknown):
// CHECK:   %1 = "chocola.constant"() <{value = "2"}> : () -> !chocola.unknown
// CHECK:   %2 = "chocola.mul"(%0, %1) : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK:   "chocola.return"(%2) : (!chocola.unknown) -> ()
// CHECK: }) : () -> !chocola.unknown
// CHECK: "chocola.func"() <{sym = "identity"}> ({
// CHECK: ^bb0(%0: !chocola.unknown):
// CHECK:   "chocola.return"(%0) : (!chocola.unknown) -> ()
// CHECK: }) : () -> !chocola.unknown
// CHECK: "chocola.func"() <{sym = "add"}> ({
// CHECK: ^bb0(%0: !chocola.unknown, %1: !chocola.unknown):
// CHECK:   %2 = "chocola.add"(%0, %1) : (!chocola.unknown, !chocola.unknown) -> !chocola.unknown
// CHECK:   "chocola.return"(%2) : (!chocola.unknown) -> ()
// CHECK: }) : () -> !chocola.unknown
// CHECK: "chocola.enum"() <{sym = "Color", typeParams = ""}> ({
// CHECK:   "chocola.enum_case"() <{sym = "Red", fields = ""}> : () -> ()
// CHECK:   "chocola.enum_case"() <{sym = "Green", fields = ""}> : () -> ()
// CHECK:   "chocola.enum_case"() <{sym = "Blue", fields = ""}> : () -> ()
// CHECK: }) : () -> ()
// CHECK: "chocola.enum"() <{sym = "Tree", typeParams = "a"}> ({
// CHECK:   "chocola.enum_case"() <{sym = "Leaf", fields = "value: TName(a)"}> : () -> ()
// CHECK:   "chocola.enum_case"() <{sym = "Node", fields = "left: TName(Tree), right: TName(Tree)"}> : () -> ()
// CHECK: }) : () -> ()
