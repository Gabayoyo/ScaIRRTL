// RUN: choco-opt %s | filecheck %s

val i = 42
val d = 3.14
val s = "hello"
val t = true
val f = false
val n = Nil

// CHECK: Parsing succeeded.
// CHECK: "chocola.constant"() <{value = "42"}> : () -> !chocola.unknown
// CHECK: "chocola.constant"() <{value = "3.14"}> : () -> !chocola.unknown
// CHECK: "chocola.constant"() <{value = "hello"}> : () -> !chocola.unknown
// CHECK: "chocola.constant"() <{value = "true"}> : () -> !chocola.unknown
// CHECK: "chocola.constant"() <{value = "false"}> : () -> !chocola.unknown
// CHECK: "chocola.constant"() <{value = "Nil"}> : () -> !chocola.unknown
